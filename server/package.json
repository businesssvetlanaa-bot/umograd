{
  "name": "umograd-server",
  "version": "1.0.0",
  "description": "Umograd API Server",
  "main": "dist/index.js",
  "engines": { "node": ">=22.13" },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "test:local-tutor": "npm run build && node --test dist/services/localTutor.test.js",
    "test:child-access": "npm run build && node --test dist/services/childAccess.test.js",
    "test:account-security": "npm run build && node --test dist/services/accountSecurity.test.js dist/services/accountLifecycle.test.js",
    "test:building-purchase": "npm run build && node --test dist/services/buildingPurchase.test.js dist/services/buildingPurchase.integration.test.js",
    "test:startup-safety": "npm run build && node --test dist/config/runtime.test.js dist/config/startupGuards.test.js dist/services/databaseReadiness.test.js",
    "start": "npm run preflight && node dist/index.js --production",
    "start:local": "npm run db:init:local && npm run db:seed && node dist/index.js",
    "preflight": "node dist/preflight.js --production",
    "preflight:local": "node dist/preflight.js",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:seed": "tsx src/data/seed.ts",
    "db:init:local": "node scripts/init-local-db.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@prisma/client": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.0.0",
    "express": "^4.18.0",
    "jsonwebtoken": "^9.0.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/node": "^22.0.0",
    "prisma": "^6.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
