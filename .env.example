# Runtime mode. Keep development locally; hosting uses production.
NODE_ENV=development

# Local SQLite. Production must use an absolute path on a persistent mounted disk.
DATABASE_URL=file:./dev.db
UMOGRAD_PERSISTENT_DB_CONFIRMED=false
# Production example (replace with the actual mounted path):
# DATABASE_URL=file:/var/lib/umograd/umograd.sqlite
# UMOGRAD_PERSISTENT_DB_CONFIRMED=true

# JWT auth. Production requires a random, non-placeholder value of at least 32 characters.
JWT_SECRET=umograd-local-development-secret

# Optional AI photo recognition. Text tutoring works locally without a paid AI key.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=

# Optional/reserved Cloudflare R2 storage settings.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Server. CLIENT_URL is optional in production when client and API share one origin.
PORT=5001
CLIENT_URL=http://127.0.0.1:3001
